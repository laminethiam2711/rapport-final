# À saisir dans Render > Environment (NE JAMAIS pousser ce fichier rempli sur GitHub)
APP_NAME=GestNotes
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:COLLE_ICI_LA_CLE_GENEREE
APP_URL=https://ton-api.onrender.com
PORT=10000
FRONTEND_URL=https://ton-site.vercel.app

LOG_CHANNEL=stderr

# Exemple PostgreSQL (Render, Neon...)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Exemple MySQL (Aiven, TiDB...) : DB_CONNECTION=mysql et DB_PORT=3306
SESSION_DRIVER=file
CACHE_STORE=file
