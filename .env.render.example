# ===== À saisir dans Render > Environment (jamais dans GitHub) =====
APP_NAME="Gestion des notes"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:COLLE_ICI_LA_CLE_GENEREE
APP_URL=https://VOTRE-API.onrender.com
APP_LOCALE=fr
PORT=10000

# Adresse du site Angular (Vercel), sans "/" final
FRONTEND_URL=https://VOTRE-SITE.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ----- Option A : PostgreSQL (Render, Neon...) -----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gestion_notes
DB_USERNAME=postgres
DB_PASSWORD=

# ----- Option B : MySQL (Aiven, TiDB, Railway...) -----
# DB_CONNECTION=mysql
# DB_PORT=3306
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt   (si l'hébergeur impose SSL)

# Premier déploiement uniquement : charge les données de démonstration, puis SUPPRIMER cette ligne
# RUN_SEED=true
